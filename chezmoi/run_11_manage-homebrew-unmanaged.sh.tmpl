#!/bin/sh
set -eu

if [ "${CHEZMOI_CI:-0}" = "1" ] || [ ! -r /dev/tty ]; then
  exit 0
fi

if command -v brew >/dev/null 2>&1; then
  brew_cmd="$(command -v brew)"
elif [ -x /opt/homebrew/bin/brew ]; then
  brew_cmd="/opt/homebrew/bin/brew"
elif [ -x /usr/local/bin/brew ]; then
  brew_cmd="/usr/local/bin/brew"
else
  exit 0
fi

tmp_brewfile="$(mktemp)"
tmp_base_brewfile="$(mktemp)"
tmp_wanted_formula="$(mktemp)"
tmp_wanted_cask="$(mktemp)"
tmp_personal_wanted_formula="$(mktemp)"
tmp_personal_wanted_cask="$(mktemp)"
tmp_installed_formula="$(mktemp)"
tmp_installed_cask="$(mktemp)"
tmp_extra_formula="$(mktemp)"
tmp_extra_cask="$(mktemp)"
tmp_extra_formula_managed_by_personal="$(mktemp)"
tmp_extra_cask_managed_by_personal="$(mktemp)"
tmp_top_extra_formula="$(mktemp)"
tmp_leaves_formula="$(mktemp)"
tmp_delete_formula="$(mktemp)"
tmp_delete_cask="$(mktemp)"
tmp_keep_formula="$(mktemp)"
tmp_keep_cask="$(mktemp)"
trap 'rm -f "$tmp_brewfile" "$tmp_base_brewfile" "$tmp_wanted_formula" "$tmp_wanted_cask" "$tmp_personal_wanted_formula" "$tmp_personal_wanted_cask" "$tmp_installed_formula" "$tmp_installed_cask" "$tmp_extra_formula" "$tmp_extra_cask" "$tmp_extra_formula_managed_by_personal" "$tmp_extra_cask_managed_by_personal" "$tmp_top_extra_formula" "$tmp_leaves_formula" "$tmp_delete_formula" "$tmp_delete_cask" "$tmp_keep_formula" "$tmp_keep_cask"' EXIT

cat >"$tmp_base_brewfile" <<'EOF_BREWFILE'
{{ include "Brewfile" }}
EOF_BREWFILE
cat "$tmp_base_brewfile" >"$tmp_brewfile"

if [ "{{ if dig "profile" "is_personal_pc" true . }}1{{ else }}0{{ end }}" = "1" ]; then
  cat >>"$tmp_brewfile" <<'EOF_PERSONAL_BREWFILE'
{{ include "Brewfile.personal" }}
EOF_PERSONAL_BREWFILE
fi

total_steps=5
current_step=0
ESC="$(printf '\033')"
RESET="${ESC}[0m"
BOLD="${ESC}[1m"
DIM="${ESC}[2m"
RED="${ESC}[31m"
GREEN="${ESC}[32m"
YELLOW="${ESC}[33m"
BLUE="${ESC}[34m"

header() {
  printf "\n${BOLD}${BLUE}== %s ==${RESET}\n" "$1" > /dev/tty
}

progress_step() {
  current_step=$((current_step + 1))
  printf "${DIM}[%d/%d]${RESET} %s\n" "$current_step" "$total_steps" "$1" > /dev/tty
}

run_with_spinner() {
  message="$1"
  shift
  "$@" &
  cmd_pid=$!
  i=0
  set +e
  while kill -0 "$cmd_pid" 2>/dev/null; do
    i=$(( (i + 1) % 4 ))
    case "$i" in
      0) ch='|' ;;
      1) ch='/' ;;
      2) ch='-' ;;
      3) ch='\\' ;;
    esac
    printf "\r    ${DIM}%s${RESET} %s" "$ch" "$message" > /dev/tty
    sleep 0.1
  done
  wait "$cmd_pid"
  status=$?
  set -e
  printf "\r    ${GREEN}✅${RESET} %s\n" "$message" > /dev/tty
  return "$status"
}

header "Homebrew Unmanaged Check"
source_dir="{{ .chezmoi.sourceDir }}"
personal_brewfile="$source_dir/Brewfile.personal"
[ -f "$personal_brewfile" ] || : >"$personal_brewfile"

progress_step "Collecting installed packages"
run_with_spinner "reading brew list" sh -c "\"$brew_cmd\" list --formula | sort -u >\"$tmp_installed_formula\""
run_with_spinner "reading cask list" sh -c "\"$brew_cmd\" list --cask | sort -u >\"$tmp_installed_cask\""

progress_step "Collecting desired packages from Brewfile"
awk -F'"' '/^brew "/ { print $2 }' "$tmp_base_brewfile" | sort -u >"$tmp_wanted_formula"
awk -F'"' '/^cask "/ { print $2 }' "$tmp_base_brewfile" | awk -F'/' '{ print $NF }' | sort -u >"$tmp_wanted_cask"
awk -F'"' '/^brew "/ { print $2 }' "$source_dir/Brewfile.personal" 2>/dev/null | sort -u >"$tmp_personal_wanted_formula" || : >"$tmp_personal_wanted_formula"
awk -F'"' '/^cask "/ { print $2 }' "$source_dir/Brewfile.personal" 2>/dev/null | awk -F'/' '{ print $NF }' | sort -u >"$tmp_personal_wanted_cask" || : >"$tmp_personal_wanted_cask"
comm -23 "$tmp_installed_formula" "$tmp_wanted_formula" >"$tmp_extra_formula" || true
comm -23 "$tmp_installed_cask" "$tmp_wanted_cask" >"$tmp_extra_cask" || true
comm -12 "$tmp_extra_formula" "$tmp_personal_wanted_formula" >"$tmp_extra_formula_managed_by_personal" || true
comm -12 "$tmp_extra_cask" "$tmp_personal_wanted_cask" >"$tmp_extra_cask_managed_by_personal" || true
comm -23 "$tmp_extra_formula" "$tmp_personal_wanted_formula" >"$tmp_extra_formula.tmp" || true
mv "$tmp_extra_formula.tmp" "$tmp_extra_formula"
comm -23 "$tmp_extra_cask" "$tmp_personal_wanted_cask" >"$tmp_extra_cask.tmp" || true
mv "$tmp_extra_cask.tmp" "$tmp_extra_cask"

append_personal_if_missing() {
  entry="$1"
  if ! grep -Fqx "$entry" "$personal_brewfile"; then
    printf '%s\n' "$entry" >>"$personal_brewfile"
    echo "Added to Brewfile.personal: $entry"
  else
    echo "Already in Brewfile.personal: $entry"
  fi
}

build_top_level_formula_list() {
  run_with_spinner "finding top-level formulae" sh -c "\"$brew_cmd\" leaves | sort -u >\"$tmp_leaves_formula\""
  comm -12 "$tmp_extra_formula" "$tmp_leaves_formula" >"$tmp_top_extra_formula" || true

  total_extra="$(wc -l <"$tmp_extra_formula" | tr -d ' ')"
  total_top="$(wc -l <"$tmp_top_extra_formula" | tr -d ' ')"
  skipped_dependency_count=$((total_extra - total_top))
  if [ "$skipped_dependency_count" -gt 0 ]; then
    printf "\n${DIM}Auto-skipped dependency brews: %s${RESET}\n" "$skipped_dependency_count" > /dev/tty
  fi
}

select_extra() {
  kind="$1"; list_file="$2"; delete_file="$3"; keep_file="$4"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    printf "\n${BOLD}Unmanaged ${kind}${RESET}  ${YELLOW}%s${RESET}\n" "$name" > /dev/tty
    if [ "$kind" = "brew" ]; then
      printf "  ${DIM}required by:${RESET} none (top-level or orphan)\n" > /dev/tty
    fi
    printf "  ${RED}[d] uninstall${RESET}  ${YELLOW}[l] move to Brewfile.personal${RESET}  ${GREEN}[s] skip${RESET}\n" > /dev/tty
    printf "  Select [d/l/s] (default: s): " > /dev/tty
    read -r choice < /dev/tty || choice="s"
    case "$choice" in
      d|D)
        printf '%s\n' "$name" >>"$delete_file"
        ;;
      l|L)
        printf '%s\n' "$name" >>"$keep_file"
        ;;
      *)
        printf '  %sSkipped%s: %s\n' "$GREEN" "$RESET" "$name" > /dev/tty
        ;;
    esac
  done <"$list_file"
}

progress_step "Preparing top-level unmanaged brew candidates"
build_top_level_formula_list
personal_brew_count="$(wc -l <"$tmp_extra_formula_managed_by_personal" | tr -d ' ')"
personal_cask_count="$(wc -l <"$tmp_extra_cask_managed_by_personal" | tr -d ' ')"
if [ "$personal_brew_count" -gt 0 ] || [ "$personal_cask_count" -gt 0 ]; then
  printf "${DIM}Auto-skipped (managed by Brewfile.personal): brew=%s cask=%s${RESET}\n" "$personal_brew_count" "$personal_cask_count" > /dev/tty
fi
progress_step "Review unmanaged packages"
select_extra "brew" "$tmp_top_extra_formula" "$tmp_delete_formula" "$tmp_keep_formula"
select_extra "cask" "$tmp_extra_cask" "$tmp_delete_cask" "$tmp_keep_cask"

delete_formula_count="$(wc -l <"$tmp_delete_formula" | tr -d ' ')"
delete_cask_count="$(wc -l <"$tmp_delete_cask" | tr -d ' ')"
keep_formula_count="$(wc -l <"$tmp_keep_formula" | tr -d ' ')"
keep_cask_count="$(wc -l <"$tmp_keep_cask" | tr -d ' ')"

total_selected=$((delete_formula_count + delete_cask_count + keep_formula_count + keep_cask_count))
if [ "$total_selected" -eq 0 ]; then
  printf "\n${GREEN}No changes selected.${RESET}\n" > /dev/tty
  exit 0
fi

progress_step "Confirm and apply"
header "Planned Changes"
printf "  ${RED}uninstall brew${RESET}: %s\n" "$delete_formula_count" > /dev/tty
if [ "$delete_formula_count" -gt 0 ]; then
  sed 's/^/    - /' "$tmp_delete_formula" > /dev/tty
fi
printf "  ${RED}uninstall cask${RESET}: %s\n" "$delete_cask_count" > /dev/tty
if [ "$delete_cask_count" -gt 0 ]; then
  sed 's/^/    - /' "$tmp_delete_cask" > /dev/tty
fi
printf "  ${YELLOW}move brew to Brewfile.personal${RESET}: %s\n" "$keep_formula_count" > /dev/tty
if [ "$keep_formula_count" -gt 0 ]; then
  sed 's/^/    - /' "$tmp_keep_formula" > /dev/tty
fi
printf "  ${YELLOW}move cask to Brewfile.personal${RESET}: %s\n" "$keep_cask_count" > /dev/tty
if [ "$keep_cask_count" -gt 0 ]; then
  sed 's/^/    - /' "$tmp_keep_cask" > /dev/tty
fi
printf "\n${BOLD}Apply all changes?${RESET} [y/N]: " > /dev/tty
read -r confirm < /dev/tty || confirm="n"
case "$confirm" in
  y|Y)
    :
    ;;
  *)
    printf "${YELLOW}Canceled.${RESET}\n" > /dev/tty
    exit 0
    ;;
esac

while IFS= read -r name; do
  [ -n "$name" ] || continue
  "$brew_cmd" uninstall "$name"
done <"$tmp_delete_formula"

while IFS= read -r name; do
  [ -n "$name" ] || continue
  "$brew_cmd" uninstall --cask "$name"
done <"$tmp_delete_cask"

while IFS= read -r name; do
  [ -n "$name" ] || continue
  append_personal_if_missing "brew \"$name\""
done <"$tmp_keep_formula"

while IFS= read -r name; do
  [ -n "$name" ] || continue
  append_personal_if_missing "cask \"$name\""
done <"$tmp_keep_cask"

header "Done"
printf "${GREEN}Applied changes successfully.${RESET}\n" > /dev/tty
