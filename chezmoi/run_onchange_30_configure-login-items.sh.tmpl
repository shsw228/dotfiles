#!/bin/sh
set -eu

osascript <<'APPLESCRIPT' >/dev/null 2>&1 || true
tell application "System Events"
  -- Raycast は使わなくなった。残っていると存在しないアプリを起動しようとする。
  if exists login item "Raycast" then
    delete login item "Raycast"
  end if

  -- Yashiki はログイン項目では起動しない（下の LaunchAgent で管理）。
  -- 残っていると LaunchAgent と二重に上がるので消す。
  if exists login item "Yashiki" then
    delete login item "Yashiki"
  end if
end tell
APPLESCRIPT

# 旧 LaunchAgent 方式の名残。ラベルが変わっているので残っていれば除去する（冪等）。
old_plist="$HOME/Library/LaunchAgents/com.shsw228.yashiki-autostart.plist"
if [ -f "$old_plist" ]; then
  launchctl bootout "gui/$(id -u)/com.shsw228.yashiki-autostart" 2>/dev/null || true
  rm -f "$old_plist"
fi

# sketchybar と borders は yashiki の init が exec --track で起動する。
# brew services に残っていると二重起動になるため止める。
#   - borders は単一インスタンスガードで yashiki 側が即死し、tracked_processes に
#     死んだ pid が残る（実際そうなっていた）
#   - sketchybar は起動順が競合し、yashiki より先に上がった回だけ bridge が壊れる
if command -v brew >/dev/null 2>&1; then
  brew_cmd="$(command -v brew)"
elif [ -x /opt/homebrew/bin/brew ]; then
  brew_cmd="/opt/homebrew/bin/brew"
elif [ -x /usr/local/bin/brew ]; then
  brew_cmd="/usr/local/bin/brew"
else
  brew_cmd=""
fi

if [ -n "$brew_cmd" ]; then
  for svc in sketchybar borders; do
    if "$brew_cmd" services list 2>/dev/null | awk -v s="$svc" '$1 == s {print $2}' | grep -qx "started"; then
      "$brew_cmd" services stop "$svc" >/dev/null 2>&1 || true
    fi
  done
fi

{{- $wm := dig "wm" "kind" "aerospace" . }}
{{ if ne $wm "aerospace" -}}
# 自動起動するWMは data.wm.kind = {{ $wm | quote }}。AeroSpace は動かさない。
#
# LaunchAgent は KeepAlive なので、止めるには bootout してラベルを外す必要がある。
# launchd はジョブ終了時にプロセスグループごと落とすので、AeroSpace の
# after-startup-command が起こした sketchybar / borders もここでまとめて落ちる。
# sketchybar を出したくなったら別途起こす。
#
# 別のWMを試すときは、その自動起動をこの分岐に足す。
#
# plist は残す。data.wm.kind を aerospace に戻して apply すれば下の分岐が
# bootstrap し直す。
launchctl bootout "gui/$(id -u)/com.shsw228.aerospace" 2>/dev/null || true
# yashiki 時代の LaunchAgent が残っていると二重に窓を奪い合う。
launchctl bootout "gui/$(id -u)/com.shsw228.yashiki" 2>/dev/null || true
rm -f "$HOME/Library/LaunchAgents/com.shsw228.yashiki.plist"

{{ else -}}
# AeroSpace(タイル型WM)を LaunchAgent で起動する。
#
# AeroSpace 自身の start-at-login は使わない (aerospace.toml では false)。
# ログイン項目ではなく LaunchAgent なのは、クラッシュ時に連携プロセスを道連れに
# したいから。launchd はジョブ終了時にプロセスグループごと SIGKILL するので、
# after-startup-command が起こした sketchybar と borders がまとめて落ちる。
# ログイン項目は launchd ジョブではないのでこれが効かず、WM だけ死んで bar が
# 取り残される。
#
# AbandonProcessGroup は既定 (false) のままにすること。true にすると上の連鎖が
# 止まる。KeepAlive と組み合わせて「まとめて落ちて、まとめて上がり直す」にする。
#
# 配置は Brewfile の cask "nikitabobko/tap/aerospace" が行う。
plist="$HOME/Library/LaunchAgents/com.shsw228.aerospace.plist"
app="/Applications/AeroSpace.app/Contents/MacOS/AeroSpace"

# yashiki から移ってきた環境では、前の LaunchAgent が残っていると窓を奪い合う。
launchctl bootout "gui/$(id -u)/com.shsw228.yashiki" 2>/dev/null || true
rm -f "$HOME/Library/LaunchAgents/com.shsw228.yashiki.plist"

if [ ! -x "$app" ]; then
  # brew bundle より後に走る想定なので、ここで無いのは異常。
  # 黙って抜けると WM が上がらない理由が分からなくなる。
  echo "aerospace: $app が見つかりません。" >&2
  echo "           brew install --cask nikitabobko/tap/aerospace を確認してください。" >&2
fi

if [ -n "${app:-}" ] && [ -x "$app" ]; then
  mkdir -p "$HOME/Library/LaunchAgents"
  cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shsw228.aerospace</string>
  <key>ProgramArguments</key>
  <array>
    <string>$app</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>$HOME/Library/Logs/aerospace.out.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/Library/Logs/aerospace.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
PLIST

  # 既に動いているときは上げ直さない。手で起動している最中に bootstrap すると
  # 二重起動になる。次回ログインで RunAtLoad が拾う。
  if ! pgrep -f 'MacOS/AeroSpace' >/dev/null 2>&1; then
    launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || true
  fi
fi
{{ end -}}
