#!/bin/sh
# yashiki init script
# Shaped to feel like the previous AeroSpace setup. A tag here is an AeroSpace
# workspace. Original config: ~/.config/aerospace/aerospace.toml

# Homebrew on yashiki's exec path, for borders and friends
yashiki add-exec-path /opt/homebrew/bin

##### Layout and gaps #####
yashiki layout-set-default tatami
# top: sketchybar y_offset(8) + height(32) + margin(8) = 48, kept a multiple of 4.
# Only an initial value: display_watcher.sh reads the configuration and applies
# a per-display gap once it is running.
yashiki set-outer-gap 48 12 12 12
yashiki layout-cmd --layout tatami set-inner-gap 10
# master:stack = 6:4
yashiki layout-cmd --layout tatami set-main-ratio 0.6

##### Cursor and focus behaviour #####
# Equivalent of the old on-focus-changed "move-mouse window-lazy-center"
yashiki set-cursor-warp on-focus-change
# No focus-follows-mouse: hovering must not activate a window
yashiki set-auto-raise disabled

##### Menu bar #####
# sketchybar shows the workspace, so the built-in indicator stays off
yashiki set-menu-bar-status disabled

##### Companion processes #####
# Start companions from yashiki so they share its process group; launchd then
# takes them all down together, including on a crash (leave AbandonProcessGroup
# at its default in the LaunchAgent). Running them from brew services as well
# collides with their single-instance guard.
yashiki exec --track "borders active_color=0xffe1e3e4 inactive_color=0xff494d64 width=5.0"

##### Tag bindings #####
# Follows yashiki's official Power User config:
#   alt-N        : view tag N exclusively
#   alt-shift-N  : move the focused window to tag N, for fixing misplacements
#   alt-ctrl-N   : toggle the focused window's membership of tag N. Adding also
#                  follows the view; removing leaves it. (wrapper toggle_tag.sh)
TOGGLE_TAG_SH="${HOME}/.config/yashiki/toggle_tag.sh"
for i in 1 2 3 4 5 6 7 8 9; do
  bit=$((1 << (i - 1)))
  yashiki bind "alt-$i"       tag-view           "$bit"
  yashiki bind "alt-shift-$i" window-move-to-tag "$bit"
  yashiki bind "alt-ctrl-$i"  exec               "$TOGGLE_TAG_SH $bit"
done
yashiki bind "alt-0"       tag-view           "$((1 << 9))"
yashiki bind "alt-shift-0" window-move-to-tag "$((1 << 9))"
yashiki bind "alt-ctrl-0"  exec               "$TOGGLE_TAG_SH $((1 << 9))"

# Tag back-and-forth, restores the previous view
yashiki bind alt-tab tag-view-last

##### Window focus (was alt-h/j/k/l) #####
yashiki bind alt-h window-focus left
yashiki bind alt-j window-focus down
yashiki bind alt-k window-focus up
yashiki bind alt-l window-focus right

##### Window swap (was alt-shift-h/j/k/l = move) #####
yashiki bind alt-shift-h window-swap left
yashiki bind alt-shift-j window-swap down
yashiki bind alt-shift-k window-swap up
yashiki bind alt-shift-l window-swap right

##### Monitors, per yashiki's Power User config #####
yashiki bind alt-o       output-focus next   # focus the next monitor
yashiki bind alt-shift-o output-send  next   # send the focused window there

##### Screenshot (was alt-shift-s) #####
yashiki bind alt-shift-s exec "screencapture -i -c"

##### Layout and float (was alt-f / alt-space) #####
yashiki bind alt-f window-toggle-fullscreen
yashiki bind alt-space window-toggle-float
# Promote the focused window to master; the old master drops to the stack
yashiki bind alt-z layout-cmd zoom

##### resize mode (was alt-r) #####
# tatami is master-stack, so h/l adjust main-ratio and j/k adjust main-count.
# main-count is reported to sketchybar through a wrapper.
MAIN_COUNT_SH="${HOME}/.config/yashiki/main_count.sh"
yashiki declare-mode resize
yashiki bind alt-r enter-mode resize
yashiki bind --mode resize h layout-cmd dec-main-ratio
yashiki bind --mode resize l layout-cmd inc-main-ratio
yashiki bind --mode resize j exec "$MAIN_COUNT_SH dec"
yashiki bind --mode resize k exec "$MAIN_COUNT_SH inc"
yashiki bind --mode resize return enter-mode normal
yashiki bind --mode resize escape enter-mode normal

# Same adjustment without entering the mode
yashiki bind alt-comma  exec "$MAIN_COUNT_SH dec"
yashiki bind alt-period exec "$MAIN_COUNT_SH inc"

# Push the current value to sketchybar so it has something to show at startup
yashiki exec "$MAIN_COUNT_SH notify"

##### Window rules (was on-window-detected) #####
# tag bitmask: 1=1, 2=2, 3=4, 4=8

# Browser → tag 1
yashiki rule-add --app-id com.google.Chrome tags 1
yashiki rule-add --app-id net.imput.helium tags 1

# Terminal → tag 2
yashiki rule-add --app-id com.mitchellh.ghostty tags 2
yashiki rule-add --app-id com.apple.Terminal tags 2
# Ghostty's Quick Terminal slides down over everything; leave it unmanaged
yashiki rule-add --ax-id com.mitchellh.ghostty.quickTerminal ignore

# Xcode + iOS Simulator → tag 3
yashiki rule-add --app-id com.apple.dt.Xcode tags 4
yashiki rule-add --app-id com.apple.iphonesimulator tags 4

# AI / codex → tag 4
yashiki rule-add --app-id com.openai.codex tags 8

# Music goes to tag 10 (alt-0), on the built-in display when one is attached
yashiki rule-add --app-id com.apple.Music tags 512
yashiki rule-add --app-id com.apple.Music output "Built-in"

# System Settings refuses programmatic resize, so float it
yashiki rule-add --app-id com.apple.systempreferences float

# The Wi-Fi captive portal is a short-lived helper window
yashiki rule-add --app-id com.apple.CaptiveNetworkAssistant ignore

# Non-normal windows such as palettes are not ours to manage
yashiki rule-add --window-level other ignore
# Helper windows without a close button: popups, dropdowns, tooltips
yashiki rule-add --close-button none ignore
# Helpers with no declared role, such as Chrome's autocomplete
yashiki rule-add --subrole AXUnknown ignore

# Utility apps are never tiled
yashiki rule-add --app-id pro.betterdisplay.BetterDisplay ignore
yashiki rule-add --app-id com.pointum.hazeover ignore
yashiki rule-add --app-name borders ignore
yashiki rule-add --app-name sketchybar ignore

##### Following display configuration #####
# Rebuild sketchybar and re-apply the per-display outer gap whenever the
# configuration changes. sketchybar derives its item layout from the display
# configuration at startup, so hotplugs and menu bar changes need a reload.
DISPLAY_WATCHER_SH="${HOME}/.config/yashiki/display_watcher.sh"
[ -x "$DISPLAY_WATCHER_SH" ] && "$DISPLAY_WATCHER_SH" >/dev/null 2>&1 &

##### Following focus #####
# Switch the borders frame colour between floating and tiling, and restore
# focus when it ends up nowhere. yashiki has no event hooks, so a long-running
# subscriber handles it.
FOCUS_WATCHER_SH="${HOME}/.config/yashiki/focus_watcher.sh"
[ -x "$FOCUS_WATCHER_SH" ] && "$FOCUS_WATCHER_SH" >/dev/null 2>&1 &

##### sketchybar #####
# Started last. The bridge and list-outputs need a live yashiki, so they would
# miss it unless the configuration and the watchers are already in place.
yashiki exec --track "sketchybar"
