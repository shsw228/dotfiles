#!/bin/sh
# Brewfile.personal は実行時に読むだけなので、ハッシュを埋めないと編集しても再実行されない。
{{ $personal := joinPath .chezmoi.sourceDir "Brewfile.personal" -}}
{{ if stat $personal }}# Brewfile.personal hash: {{ include $personal | sha256sum }}{{ end }}
set -eu
{{ template "step.sh" "Homebrew パッケージのインストール" }}

if command -v brew >/dev/null 2>&1; then
  brew_cmd="$(command -v brew)"
elif [ -x /opt/homebrew/bin/brew ]; then
  brew_cmd="/opt/homebrew/bin/brew"
elif [ -x /usr/local/bin/brew ]; then
  brew_cmd="/usr/local/bin/brew"
else
  say "Homebrew is not installed. Install Homebrew first:"
  say '  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
  exit 1
fi

step "Brewfile の組み立て"
tmp_brewfile="$(mktemp)"
main_brewfile="$(mktemp)"
mas_brewfile="$(mktemp)"
cleanup() { rm -f "$tmp_brewfile" "$main_brewfile" "$mas_brewfile"; }

cat >"$tmp_brewfile" <<'EOF_BREWFILE'
{{ include "Brewfile" }}
EOF_BREWFILE

source_dir="{{ .chezmoi.sourceDir }}"
personal_brewfile="$source_dir/Brewfile.personal"
if [ "{{ if dig "profile" "is_personal_pc" true . }}1{{ else }}0{{ end }}" = "1" ] && [ "${CHEZMOI_CI:-0}" != "1" ] && [ -f "$personal_brewfile" ]; then
  cat "$personal_brewfile" >>"$tmp_brewfile"
fi

step "tap の追加と trust"
if "$brew_cmd" trust --help >/dev/null 2>&1; then
  awk -F'"' '/^[[:space:]]*tap[[:space:]]+"/ {print $2}' "$tmp_brewfile" | while IFS= read -r tap_name; do
    [ -z "$tap_name" ] && continue
    case "$tap_name" in
      homebrew/*) continue ;;
    esac
    if ! "$brew_cmd" tap | grep -qx "$tap_name"; then
      "$brew_cmd" tap "$tap_name"
    fi
    "$brew_cmd" trust "$tap_name" >/dev/null 2>&1 || true
  done
fi

grep -E '^[[:space:]]*mas[[:space:]]+"' "$tmp_brewfile" >"$mas_brewfile" || true
grep -vE '^[[:space:]]*mas[[:space:]]+"' "$tmp_brewfile" >"$main_brewfile" || true

step "brew bundle (Brewfile)"
progress "$brew_cmd" bundle --no-upgrade --verbose --file="$main_brewfile"

step "brew bundle (Mac App Store)"
if [ -s "$mas_brewfile" ]; then
  if ! progress "$brew_cmd" bundle --no-upgrade --verbose --file="$mas_brewfile"; then
    say "Mac App Store のアプリを入れられませんでした。スキップして続行します。"
    say "  App Store.app でサインインしているか確認してください"
    say "  (mas にはサインイン機能がないため手動で行う必要があります)"
  fi
fi
