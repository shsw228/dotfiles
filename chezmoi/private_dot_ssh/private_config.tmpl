{{- $isPersonal := dig "profile" "is_personal_pc" false . -}}
Host *
    IdentityAgent ~/.1password-agent.sock

# 個人用/会社用 PC で使う鍵を1つだけ切り替える（秘密鍵は 1Password agent が保持）。
Host github.com
    User git
    IdentitiesOnly yes
{{- if $isPersonal }}
    IdentityFile ~/.ssh/github_personal.pub
{{- else }}
    IdentityFile ~/.ssh/github_work.pub
{{- end }}
